# SiteSmyth — copy to .env and fill in values

# Database (default: SQLite)
# DATABASE_URL=sqlite:///leads.db

# Google Places API (optional — use for discovery if set, else Apify)
GOOGLE_MAPS_KEY=

# Apify (discovery fallback, Facebook, Instagram scraping)
APIFY_API_TOKEN=

# Google Gemini (content generation, vision)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# Cloudflare (R2 + Worker hosting)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_BUCKET=sitesmyth-sites

# Outreach
RESEND_API_KEY=

# Phase 2 (optional)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# SiteSmyth branding (product of UndercurrentSMB; DBA/new entity if it scales)
SITESMYTH_DOMAIN=sitesmyth.com
CONTACT_EMAIL=
CONTACT_PHONE=
PHYSICAL_ADDRESS=
