---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { title = "SiteSmyth — Websites for local businesses without one", description = "We find local businesses on social media, build them a demo site from their content, and get them live in 48 hours. $1,000 flat. Your Cloudflare, your domain, zip handoff.", image = "https://sitesmyth.com/og.png" } = Astro.props;

const canonicalUrl = "https://sitesmyth.com";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="canonical" href={canonicalUrl} />

    <title>{title}</title>

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "SiteSmyth",
        "url": "https://sitesmyth.com",
        "description": "We build websites for local businesses that don't have one yet, using their social media content.",
        "foundingDate": "2025"
      }
    </script>

    <style is:global>
      html { scroll-behavior: smooth; }
      body {
        font-family: var(--font-family-sans, "Inter", system-ui, sans-serif);
        background: #020617; /* slate-950 */
        color: white;
        min-height: 100vh;
      }
    </style>
  </head>
  <body class="bg-slate-950 text-white antialiased">
    <slot />
  </body>
</html>
