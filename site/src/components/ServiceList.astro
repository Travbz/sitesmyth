---
import { SERVICES } from '../data/site';
// Full list with summaries lives on /services/ only. Elsewhere, pass compact for plain links.
// extra adds hub-only tiles after the build services; only replaces them entirely.
// level sets the tile heading tag when the list sits under a section heading.
type Tile = { href: string; h: string; p: string };
interface Props { exclude?: string; compact?: boolean; extra?: Tile[]; only?: Tile[]; level?: 'h2' | 'h3' }
const { exclude, compact, extra = [], only, level = 'h2' } = Astro.props;
const H = level;
const items = only ? [] : SERVICES.filter((s) => s.slug !== exclude);
const tiles = only ?? extra;
---
{compact ? (
  <ul class="link-list" role="list">{items.map((s) => <li><a href={`/services/${s.slug}/`}>{s.title}</a></li>)}</ul>
) : (
  <ul class="svc-list" role="list">
    {items.map((s) => (
      <li class="svc">
        <H><a href={`/services/${s.slug}/`}>{s.h1}</a></H>
        <p>{s.description}</p>
      </li>
    ))}
    {tiles.map((x) => (
      <li class="svc">
        <H><a href={x.href}>{x.h}</a></H>
        <p>{x.p}</p>
      </li>
    ))}
  </ul>
)}
