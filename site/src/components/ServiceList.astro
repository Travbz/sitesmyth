---
import { SERVICES } from '../data/site';
// Full list with summaries lives on /services/ only. Elsewhere, pass compact for plain links.
// extra adds hub-only tiles (features, monthly SEO) that are not build services.
interface Props { exclude?: string; compact?: boolean; extra?: { href: string; h: string; p: string }[] }
const { exclude, compact, extra = [] } = Astro.props;
const items = SERVICES.filter((s) => s.slug !== exclude);
---
{compact ? (
  <ul class="link-list" role="list">{items.map((s) => <li><a href={`/services/${s.slug}/`}>{s.title}</a></li>)}</ul>
) : (
  <ul class="svc-list" role="list">
    {items.map((s) => (
      <li class="svc">
        <h2><a href={`/services/${s.slug}/`}>{s.h1}</a></h2>
        <p>{s.description}</p>
      </li>
    ))}
    {extra.map((x) => (
      <li class="svc">
        <h2><a href={x.href}>{x.h}</a></h2>
        <p>{x.p}</p>
      </li>
    ))}
  </ul>
)}
