---
import HeroText from '../../components/HeroText.astro';
import Drafting from './Drafting';

// The drawing drafts itself: every stroke uses pathLength=1 so one dash rule
// animates them all, staggered by --i. Reduced motion shows it finished.
---
<section class="hero">
  <div class="wrap hero-grid">
    <div class="hero-copy"><HeroText /></div>
    <figure class="board" aria-label="Working drawing of a small business website">
      <svg class="plan" viewBox="0 0 640 500" role="img" aria-hidden="true">
        <!-- browser frame -->
        <g class="stroke">
          <rect pathLength="1" class="draw" style="--i:0" x="60" y="40" width="460" height="400" rx="6" />
          <line pathLength="1" class="draw" style="--i:1" x1="60" y1="76" x2="520" y2="76" />
          <circle pathLength="1" class="draw" style="--i:1" cx="82" cy="58" r="5" />
          <circle pathLength="1" class="draw" style="--i:1" cx="100" cy="58" r="5" />
          <circle pathLength="1" class="draw" style="--i:1" cx="118" cy="58" r="5" />
          <rect pathLength="1" class="draw" style="--i:2" x="140" y="50" width="280" height="16" rx="8" />
          <!-- site header: brand, nav, call button -->
          <line pathLength="1" class="draw" style="--i:3" x1="84" y1="102" x2="150" y2="102" />
          <line pathLength="1" class="draw" style="--i:3" x1="300" y1="102" x2="330" y2="102" />
          <line pathLength="1" class="draw" style="--i:3" x1="342" y1="102" x2="372" y2="102" />
          <line pathLength="1" class="draw" style="--i:3" x1="384" y1="102" x2="414" y2="102" />
          <rect pathLength="1" class="draw hot" style="--i:4" x="432" y="90" width="66" height="24" rx="12" />
          <!-- hero headline + cta -->
          <line pathLength="1" class="draw" style="--i:5" x1="84" y1="152" x2="340" y2="152" />
          <line pathLength="1" class="draw" style="--i:5" x1="84" y1="174" x2="280" y2="174" />
          <line pathLength="1" class="draw" style="--i:6" x1="84" y1="196" x2="240" y2="196" />
          <rect pathLength="1" class="draw hot" style="--i:7" x="84" y="218" width="110" height="30" rx="4" />
          <!-- map pin + stars -->
          <path pathLength="1" class="draw" style="--i:8" d="M430 160 a28 28 0 1 1 0 56 a28 28 0 1 1 0 -56" />
          <path pathLength="1" class="draw" style="--i:9" d="M430 172 a10 10 0 0 1 10 10 c0 7 -10 20 -10 20 c0 0 -10 -13 -10 -20 a10 10 0 0 1 10 -10" />
          <g class="draw" style="--i:10">
            <path pathLength="1" d="M84 282 l4 8 9 1 -6 6 1 9 -8 -4 -8 4 1 -9 -6 -6 9 -1 z" />
            <path pathLength="1" d="M114 282 l4 8 9 1 -6 6 1 9 -8 -4 -8 4 1 -9 -6 -6 9 -1 z" />
            <path pathLength="1" d="M144 282 l4 8 9 1 -6 6 1 9 -8 -4 -8 4 1 -9 -6 -6 9 -1 z" />
            <path pathLength="1" d="M174 282 l4 8 9 1 -6 6 1 9 -8 -4 -8 4 1 -9 -6 -6 9 -1 z" />
            <path pathLength="1" d="M204 282 l4 8 9 1 -6 6 1 9 -8 -4 -8 4 1 -9 -6 -6 9 -1 z" />
          </g>
          <!-- service page cards -->
          <rect pathLength="1" class="draw" style="--i:11" x="84" y="324" width="130" height="84" rx="4" />
          <rect pathLength="1" class="draw" style="--i:12" x="228" y="324" width="130" height="84" rx="4" />
          <rect pathLength="1" class="draw" style="--i:13" x="372" y="324" width="130" height="84" rx="4" />
        </g>
        <!-- dimension lines + drafting notes -->
        <g class="dims">
          <g class="draw" style="--i:14">
            <line pathLength="1" x1="60" y1="468" x2="520" y2="468" />
            <line pathLength="1" x1="60" y1="460" x2="60" y2="476" />
            <line pathLength="1" x1="520" y1="460" x2="520" y2="476" />
          </g>
          <text class="note fade" style="--i:15" x="290" y="490" text-anchor="middle">LOADS FAST · READS RIGHT ON A PHONE</text>
          <g class="draw" style="--i:14">
            <line pathLength="1" x1="556" y1="40" x2="556" y2="440" />
            <line pathLength="1" x1="548" y1="40" x2="564" y2="40" />
            <line pathLength="1" x1="548" y1="440" x2="564" y2="440" />
          </g>
          <text class="note fade vert" style="--i:15" x="578" y="240" text-anchor="middle">A PAGE FOR EVERY SERVICE</text>
          <text class="note fade" style="--i:16" x="432" y="136" text-anchor="middle">TAP TO CALL</text>
          <line pathLength="1" class="draw thin" style="--i:16" x1="450" y1="118" x2="440" y2="130" />
          <text class="note fade" style="--i:16" x="258" y="268" text-anchor="start">REAL REVIEWS</text>
          <text class="note fade" style="--i:16" x="472" y="246" text-anchor="middle">ON THE MAP</text>
        </g>
      </svg>
      <figcaption class="board-cap">
        <span>SHEET 1 OF 1</span>
        <span>SCALE: TO YOUR BUSINESS</span>
      </figcaption>
      <Drafting client:idle />
    </figure>
  </div>
</section>
