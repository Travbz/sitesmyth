---
import HeroText from '../../components/HeroText.astro';
import HeroMarketing from '../../components/HeroMarketing.astro';
// A drawing of the kind of site we build, on the customer's own domain.
const pages = ['Services', 'Service area', 'Menu', 'Gallery', 'Contact'];
---
<section class="hero">
  <div class="wrap hero-grid">
    <div class="hero-copy"><HeroText /></div>
    <figure class="sketch" aria-hidden="true">
      <div class="sketch-bar"><span class="dots"></span><span class="addr">yourbusiness.com</span></div>
      <div class="sketch-page">
        <div class="sk-hero"><span class="sk-line w70"></span><span class="sk-line w45"></span><span class="sk-btn"></span></div>
        <div class="sk-tabs">{pages.map((p, i) => <span style={`--i:${i}`}>{p}</span>)}</div>
        <div class="sk-grid"><span></span><span></span><span></span></div>
      </div>
    </figure>
  </div>
  <div class="wrap"><HeroMarketing /></div>
</section>
