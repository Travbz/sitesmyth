---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import IndustryList from '../../components/IndustryList.astro';
import CtaBand from '../../components/CtaBand.astro';
const crumbs = [{ name: 'Industries', path: '/websites-for/' }];
---
<Base
  title="Website Design by Industry"
  description="Websites built for how customers search in your trade. Deep guides for HVAC, fire protection, restaurants and bars, and cleaning, and we build for every kind of business."
  crumbs={crumbs}
>
  <header class="page-head wrap">
    <Crumbs items={crumbs} />
    <h1>Website design by industry</h1>
    <p class="lede">Every trade gets searched differently. We build sites for all kinds of businesses; these are the industries we have written full guides for, each with a live example.</p>
  </header>
  <section class="section section-tight wrap" aria-label="Industries">
    <IndustryList />
    <p class="more">Yours not here yet? The process is the same for any business: find out how your customers search, then build the pages that answer them.</p>
  </section>
  <CtaBand heading="Tell us what you do" text="Whatever the industry, send a few details and we will reply with what your site needs and how we would build it." />
</Base>
