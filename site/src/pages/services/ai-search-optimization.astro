---
import DetailPage from '../../components/DetailPage.astro';
import { AI_SEARCH_PAGE, SERVICES } from '../../data/site';

const crumbs = [
  { name: 'Services', path: '/services/' },
  { name: 'AI search optimization', path: '/services/ai-search-optimization/' },
];
const siblings = [
  ...SERVICES.map((s) => ({ href: `/services/${s.slug}/`, label: s.title })),
  { href: '/services/monthly-seo/', label: 'Monthly SEO services' },
  { href: '/services/ad-management/', label: 'Ad management: Google, Facebook, and Instagram' },
];
---
<DetailPage page={AI_SEARCH_PAGE} crumbs={crumbs} siblings={siblings} siblingsHeading="Other services" cta={{ href: '/contact/', label: 'Ask about AI search optimization' }} />
