---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import ServiceList from '../../components/ServiceList.astro';
import CtaBand from '../../components/CtaBand.astro';

const crumbs = [{ name: 'Services', path: '/services/' }];
---
<Base
  title="Website Design Services for Small Businesses"
  description="Landing pages, full multi-page websites, local SEO city pages, and redesigns off Wix, GoDaddy, or WordPress. Every site handed over to you."
  crumbs={crumbs}
>
  <header class="page-head wrap">
    <Crumbs items={crumbs} />
    <h1>Website design services for small businesses</h1>
    <p class="lede">Pick the size of site your business needs today. Every one of them is built so it can grow later without starting over.</p>
  </header>
  <section class="section section-tight wrap" aria-label="Services">
    <ServiceList extra={[
      {
        href: '/services/website-features/',
        h: 'Website features: forms, booking, galleries, and more',
        p: 'Add only what your business uses: intake forms, online booking, photo galleries, menu pages, chat, and more.',
      },
      {
        href: '/services/monthly-seo-and-ads/',
        h: 'Monthly SEO and ad management',
        p: 'Its own monthly contract for businesses that want to stay ranked: Google and Bing indexing, local SEO, Google Ads, and Facebook and Instagram ads.',
      },
      {
        href: '/services/ai-search-optimization/',
        h: 'AI search optimization (AEO and GEO)',
        p: 'Build your authority with ChatGPT, Google AI Overviews, and Copilot, so when someone asks which business to use, yours gets cited. Its own service, separate from SEO.',
      },
      {
        href: '/services/google-reviews-respondyr/',
        h: 'Google reviews and map rankings with Respondyr',
        p: 'Our sister company Respondyr answers every Google review in your voice and helps you climb the map. Recommended for every local business.',
      },
    ]} />
  </section>
  <CtaBand />
</Base>
