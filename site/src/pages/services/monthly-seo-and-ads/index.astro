---
import Base from '../../../layouts/Base.astro';
import Crumbs from '../../../components/Crumbs.astro';
import CtaBand from '../../../components/CtaBand.astro';
import { MONTHLY, SITE, MONTHLY_PAGES } from '../../../data/site';

const crumbs = [{ name: 'Services', path: '/services/' }, { name: 'Monthly SEO and ads', path: '/services/monthly-seo-and-ads/' }];
const schema = [
  {
    '@type': 'Service',
    name: 'Monthly SEO and ad management for small businesses',
    provider: { '@id': `${SITE.url}/#org` },
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'Monthly marketing services',
      itemListElement: MONTHLY.map((m) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: m.h2, description: m.p } })),
    },
  },
];
---
<Base
  title="Monthly SEO and Ad Management for Small Businesses"
  description="Monthly SEO and ad management for small businesses that want to stay ranked: Google and Bing indexing, ongoing local SEO, AI search optimization, Google Ads, and Facebook and Instagram ads, on its own monthly contract."
  crumbs={crumbs}
  schema={schema}
>
  <header class="page-head wrap">
    <Crumbs items={crumbs} />
    <h1>Monthly SEO and ad management for small businesses</h1>
    <p class="lede">For businesses that want to get ranked and stay ranked. This is its own service on its own monthly contract, separate from any website build, so you can sign up without one. Pick the pieces your business needs.</p>
  </header>
  <section class="section section-tight wrap" aria-label="Monthly services">
    <ul class="svc-list feature-list" role="list">
      {MONTHLY.map((m) => (
        <li class="svc" id={m.slug}>
          <h2>{MONTHLY_PAGES[m.slug] ? <a href={`/services/monthly-seo-and-ads/${m.slug}/`}>{m.h2}</a> : m.h2}</h2>
          <p>{m.p}</p>
        </li>
      ))}
    </ul>
  </section>
  <CtaBand heading="Ask about monthly SEO and ads" text="Tell us about your business and where you want to rank, and we will reply with what we would do each month." />
</Base>
