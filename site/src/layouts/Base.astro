---
import '../styles/base.css';
import '@theme/fonts.ts';
import '@theme/theme.css';
import Header from '@theme/Header.astro';
import Footer from '@theme/Footer.astro';
import { SITE, SERVICES, MONTHLY_GROUPS } from '../data/site';

interface Props {
  title: string;
  description: string;
  schema?: object[];
  crumbs?: { name: string; path: string }[];
}

const { title, description, schema = [], crumbs = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const fullTitle = title.includes(SITE.name) ? title : `${title} | ${SITE.name}`;
// Design previews stay out of search. Only the production build is indexable.
const indexable = process.env.PROD === '1';
// Link previews (iMessage, Facebook, LinkedIn, Slack) show SiteSmyth's own branded card,
// never a client's site. Regenerate with node scripts/brand-assets.mjs.
const ogImage = new URL('/og.png', SITE.url).href;

const graph = [
  // One business entity on every page. No address or service area by Travis's ruling;
  // add sameAs links once the SiteSmyth Google Business Profile and socials exist.
  {
    '@type': ['Organization', 'ProfessionalService'],
    '@id': `${SITE.url}/#org`,
    name: SITE.name,
    url: SITE.url,
    description: SITE.description,
    logo: `${SITE.url}/apple-touch-icon.png`,
    contactPoint: { '@type': 'ContactPoint', contactType: 'sales', url: `${SITE.url}/contact/` },
    knowsAbout: ['Small business website design', 'Local SEO', 'Google Ads management', 'Meta ads management', 'AI search optimization'],
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'SiteSmyth services',
      itemListElement: [
        ...SERVICES.map((s) => ({ name: s.h1, url: `${SITE.url}/services/${s.slug}/` })),
        { name: 'Website features', url: `${SITE.url}/services/website-features/` },
        ...Object.entries(MONTHLY_GROUPS).map(([k, g]) => ({ name: g.h1, url: `${SITE.url}/services/${k}/` })),
        { name: 'AI search optimization (AEO and GEO)', url: `${SITE.url}/services/ai-search-optimization/` },
      ].map((o) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: o.name, url: o.url } })),
    },
  },
  { '@type': 'WebSite', '@id': `${SITE.url}/#site`, name: SITE.name, url: SITE.url, publisher: { '@id': `${SITE.url}/#org` } },
  ...(crumbs.length
    ? [
        {
          '@type': 'BreadcrumbList',
          itemListElement: [{ name: 'Home', path: '/' }, ...crumbs].map((c, i) => ({
            '@type': 'ListItem',
            position: i + 1,
            name: c.name,
            item: new URL(c.path, SITE.url).href,
          })),
        },
      ]
    : []),
  ...schema,
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {!indexable && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="SiteSmyth: small business websites you own outright" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header path={Astro.url.pathname} />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
